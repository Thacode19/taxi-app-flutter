rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Iedereen mag zijn eigen profiel lezen en schrijven
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Chauffeursprofielen zijn zichtbaar voor elke ingelogde gebruiker
      allow read: if request.auth != null && resource.data.role == 'driver';

      // Een admin mag ook andere profielen lezen en bijwerken
      allow read, update: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      // Een passagier mag na een rit alleen de rating-velden van een
      // chauffeur bijwerken — verder niets aan dat profiel
      allow update: if request.auth != null &&
        resource.data.role == 'driver' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount']);
    }

    match /rides/{rideId} {
      allow create: if request.auth != null
                    && request.resource.data.passengerId == request.auth.uid;

      allow read: if request.auth != null && (
                     resource.data.passengerId == request.auth.uid ||
                     resource.data.driverId == request.auth.uid ||
                     resource.data.status == 'searching'
                   );

      allow update: if request.auth != null && (
                       resource.data.passengerId == request.auth.uid ||
                       resource.data.driverId == request.auth.uid ||
                       (resource.data.status == 'searching' &&
                        request.resource.data.driverId == request.auth.uid)
                     );

      allow delete: if false;
    }
  }
}